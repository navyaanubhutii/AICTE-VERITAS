# ============================================================
# AICTE Veritas - Environment Configuration Example (Stage 1)
# ============================================================

# Backend Settings
APP_ENV=development
APP_NAME="AICTE Veritas"
APP_VERSION="1.0.0-stage1"
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Security & CORS (Local development defaults)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database (SQLite default for Stage 1 demo; postgresql://... supported)
DATABASE_URL=sqlite:///./data/veritas.db

# Storage (Private local folder outside public web root)
STORAGE_DIR=./data/storage
MAX_UPLOAD_SIZE_MB=10

# Demo Mode Settings
DEMO_MODE=True
